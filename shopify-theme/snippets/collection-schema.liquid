{% comment %}
  Collection JSON-LD: CollectionPage + ItemList + BreadcrumbList.
  Render from layout/theme.liquid:
    {% if request.page_type == 'collection' %}{% render 'collection-schema' %}{% endif %}
  Guarded there AND here.
  ItemList is suppressed on paginated views (?page=2+) so the markup
  never claims items the rendered page does not contain.
  The CollectionPage points at the same /#website and /#organization ids the
  Organization and Product markup use, so crawlers join them into one graph.
{% endcomment %}
{% if request.page_type == 'collection' and collection != blank %}
{%- assign show_list = true -%}
{%- if canonical_url contains 'page=' -%}{%- assign show_list = false -%}{%- endif -%}
{%- if collection.products.size == 0 -%}{%- assign show_list = false -%}{%- endif -%}
{%- if collection.image -%}
  {%- assign col_img = collection.image | image_url: width: 1600 -%}
  {%- unless col_img contains 'https:' -%}
    {%- assign col_img = col_img | prepend: 'https:' -%}
  {%- endunless -%}
{%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": {{ shop.url | append: collection.url | json }},
  "url": {{ shop.url | append: collection.url | json }},
  "name": {{ collection.title | json }},
  {%- if collection.description != blank %}
  "description": {{ collection.description | strip_html | truncate: 500 | json }},
  {%- endif %}
  {%- if col_img %}
  "primaryImageOfPage": {{ col_img | json }},
  {%- endif %}
  "isPartOf": {
    "@type": "WebSite",
    "@id": {{ shop.url | append: '/#website' | json }},
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}
  },
  "publisher": {"@id": {{ shop.url | append: '/#organization' | json }}}
  {%- if show_list -%},
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {%- for item in collection.products limit: 36 -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "name": {{ item.title | json }},
        "url": {{ shop.url | append: item.url | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  {%- endif -%}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ shop.url | append: collection.url | json }}
    }
  ]
}
</script>
{% endif %}
